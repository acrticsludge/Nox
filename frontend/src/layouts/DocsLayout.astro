---
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const { title = 'NOX // MANUAL', description = 'NEON VOID — complete rules, controls, hazards and HUD. Same keyboard, no bots.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <div class="nox-shell">
      <div class="grid-noise" aria-hidden="true"></div>

      <header class="nox-header">
        <div class="header-left" style="display:flex;align-items:center;gap:10px">
          <div class="diamond-mark"><span></span></div>
          <a href="/" class="brand-lockup" style="text-decoration:none">NOX</a>
          <span style="color:var(--nox-muted);opacity:0.5;font:10px var(--nox-mono);letter-spacing:0.1em">//</span>
          <a href="/play" class="brand-lockup" style="text-decoration:none">PLAY</a>
          <span style="color:var(--nox-muted);opacity:0.5;font:10px var(--nox-mono);letter-spacing:0.1em">//</span>
          <span class="brand-lockup" style="color:var(--nox-lime)">DOCS</span>
        </div>
        <span class="cyber-status" role="status" aria-label="Manual"><span class="cyber-status__dot"></span><span class="cyber-status__label">MANUAL // v0.1</span><span class="cyber-status__frame"><i class="cyber-status__spark"></i></span></span>
      </header>

      <div class="nox-content" style="padding-top:28px;padding-bottom:32px">
        <article class="docs-article">
          <slot />
        </article>

        <div style="margin-top:28px;display:flex;gap:10px;flex-wrap:wrap">
          <a href="/play" class="btn btn-primary" style="text-decoration:none">▶ ENTER ARENA</a>
          <a href="/play/1v1" class="btn btn-ghost" style="text-decoration:none">1V1 // PLAY</a>
          <a href="/mockup" class="btn btn-ghost" style="text-decoration:none">MOCKUP LAB</a>
        </div>
      </div>

      <footer class="nox-footer"><span>NEON VOID // DOCS // MDX</span><span>BUILT WITH SVG • NO CANVAS • 60FPS</span></footer>
    </div>

    <style is:global>
      .docs-article { color: var(--nox-fg); }
      .docs-h1 { margin:0; font:800 clamp(36px,7vw,64px)/0.86 var(--nox-mono); letter-spacing:-0.04em; }
      .docs-h1 span { background: linear-gradient(135deg,var(--nox-lime),var(--nox-cyan)); -webkit-background-clip:text; -webkit-text-fill-color:transparent; }
      .docs-lead { margin:10px 0 0; color:var(--nox-muted); font:12px/1.7 var(--nox-mono); max-width:68ch; }
      .docs-grid { display:grid; grid-template-columns: 1fr 1fr; gap:14px; margin-top:22px; }
      @media (max-width:780px){ .docs-grid{grid-template-columns:1fr} }
      .docs-card { background: rgba(255,255,255,0.03); border:1px solid var(--nox-border); clip-path: polygon(8px 0,100% 0,100% calc(100% - 8px), calc(100% - 8px) 100%,0 100%,0 8px); padding:14px; position:relative; overflow:hidden; }
      .docs-card::before{content:'';position:absolute;left:0;top:0;width:100%;height:2px;opacity:0.9}
      .docs-card--cyan::before{background:var(--nox-cyan);box-shadow:0 0 10px var(--nox-cyan)}
      .docs-card--pink::before{background:var(--nox-pink);box-shadow:0 0 10px var(--nox-pink)}
      .docs-card--amber::before{background:var(--nox-amber);box-shadow:0 0 10px var(--nox-amber)}
      .docs-card--lime::before{background:var(--nox-lime);box-shadow:0 0 10px var(--nox-lime)}
      .docs-kicker{font:10px var(--nox-mono);letter-spacing:0.14em;font-weight:800;color:var(--nox-lime);display:flex;align-items:center;gap:10px;margin-bottom:8px}
      .docs-kicker i{width:22px;height:22px;display:grid;place-items:center;border:1px solid currentColor;font-size:10px}
      .docs-h3{margin:0 0 6px;font:12px var(--nox-mono);font-weight:800;letter-spacing:0.08em;color:var(--nox-fg)}
      .docs-p{margin:0;font:12px/1.7 var(--nox-mono);color:#a9b7b9}
      .docs-p strong{color:var(--nox-fg);font-weight:800}
      .docs-list{margin:8px 0 0;padding-left:16px;font:12px/1.7 var(--nox-mono);color:#a9b7b9}
      .docs-list li{margin-bottom:2px}
      .docs-table{width:100%;border-collapse:collapse;margin-top:10px;font:12px var(--nox-mono)}
      .docs-table th{font-size:10px;letter-spacing:0.12em;color:var(--nox-muted);text-align:left;padding:8px 10px;border-bottom:1px solid var(--nox-border);background:rgba(255,255,255,0.02)}
      .docs-table td{padding:9px 10px;border-bottom:1px solid rgba(255,255,255,0.06);color:#d6e2e4}
      .docs-table tr:last-child td{border-bottom:none}
      .docs-badge{font:10px var(--nox-mono);letter-spacing:0.14em;font-weight:800;padding:4px 8px;border:1px solid;display:inline-flex;clip-path:polygon(6px 0,100% 0,100% calc(100% - 6px), calc(100% - 6px) 100%,0 100%,0 6px)}
      .docs-callout{margin-top:18px;padding:12px;border:1px solid var(--nox-border);background:linear-gradient(180deg,rgba(201,255,47,0.07),rgba(201,255,47,0.02));clip-path:polygon(8px 0,100% 0,100% calc(100% - 8px), calc(100% - 8px) 100%,0 100%,0 8px);font:12px/1.6 var(--nox-mono);color:#a9b7b9}
      .docs-hr{margin:22px 0;border:none;border-top:1px solid var(--nox-border)}
      .keycap{font-size:11px}
      code{font-family:var(--nox-mono);background:rgba(255,255,255,0.06);padding:1px 5px;border:1px solid var(--nox-border)}
    </style>
  </body>
</html>
