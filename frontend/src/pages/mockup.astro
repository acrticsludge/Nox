---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO
      title="NOX // MOCKUP LAB - Vector rework"
      description="NOX gamebox vector rework - 3 crisp directions for players, buffs, debuffs, shooting FX. Not indexed."
      canonical="/mockup"
      noindex={true}
    />
  </head>
  <body>
    <div class="nox-shell">
      <div class="grid-noise" aria-hidden="true"></div>

      <header class="nox-header">
        <a href="/" class="header-left" style="text-decoration:none">
          <div class="diamond-mark"><span></span></div>
          <span class="brand-lockup">NOX // MOCKUP LAB</span>
        </a>
        <span class="cyber-status" style="opacity:0.9"><span class="cyber-status__dot"></span><span class="cyber-status__label">NOT LIVE // 3 VARIANTS</span><span class="cyber-status__frame"><i class="cyber-status__spark"></i></span></span>
      </header>

      <div class="nox-content" style="padding-bottom:48px">
        <!-- HERO -->
        <section class="hero-section" style="padding-top:64px; padding-bottom:32px">
          <div class="eyebrow"><span class="eyebrow-line"></span> VECTOR REWORK // NO EMOJIS // CRISP SVG</div>
          <h1 class="hero-title" style="font-size:clamp(44px,8vw,96px); margin:18px 0 16px">GAMEBOX<br/><em>REWORK</em></h1>
          <p class="hero-copy" style="max-width:62ch">Blurry emojis replaced with razor vectors. Three directions - same Nox palette - pick one and we ship it to <code style="background:rgba(255,255,255,0.06); padding:2px 6px; border:1px solid var(--nox-border)">/play</code>. Shooting FX, hit sparks, dash flames all vector, not text.</p>
          <div style="display:flex; gap:10px; margin-top:22px; flex-wrap:wrap">
            <span class="cyber-badge cyber-badge--cyan"><span class="cyber-badge__text">A // RAZOR - hairline • 1px • vector</span><span class="cyber-badge__spark"></span></span>
            <span class="cyber-badge cyber-badge--lime"><span class="cyber-badge__text">B // PLASMA - soft bloom • inner glow</span><span class="cyber-badge__spark"></span></span>
            <span class="cyber-badge cyber-badge--pink"><span class="cyber-badge__text">C // FORGE - brutal • 2px • block</span><span class="cyber-badge__spark"></span></span>
          </div>
          <p style="margin-top:14px; font:11px var(--nox-mono); color:var(--nox-muted); letter-spacing:0.06em">How to use: compare columns → tell me “ship A/B/C” or “A players + B buffs + C shooting” - we’ll wire the winner into <code style="color:var(--nox-lime)">game-logic.js</code>.</p>
        </section>

        <!-- VARIANT COMPARISON GRID HEADER -->
        <div style="display:grid; grid-template-columns: repeat(3, 1fr); gap:16px; margin:18px 0 8px; font:10px var(--nox-mono); letter-spacing:0.14em; font-weight:800">
          <div style="color:var(--nox-cyan); border-left:2px solid var(--nox-cyan); padding-left:10px">A // RAZOR<br/><span style="color:var(--nox-muted); font-weight:400; letter-spacing:0.06em">sharp dart • hairline • star muzzle</span></div>
          <div style="color:var(--nox-lime); border-left:2px solid var(--nox-lime); padding-left:10px">B // PLASMA<br/><span style="color:var(--nox-muted); font-weight:400; letter-spacing:0.06em">hex drone • bloom • orb shot</span></div>
          <div style="color:var(--nox-pink); border-left:2px solid var(--nox-pink); padding-left:10px">C // FORGE<br/><span style="color:var(--nox-muted); font-weight:400; letter-spacing:0.06em">block hull • 2px • slug</span></div>
        </div>

        <!-- 01 PLAYERS -->
        <section class="mock-section">
          <div style="display:flex; align-items:center; gap:12px; margin:28px 0 16px; border-top:1px solid var(--nox-border); padding-top:22px">
            <span style="font:10px var(--nox-mono); letter-spacing:0.16em; color:var(--nox-lime)">01 // PLAYER CHARACTERS</span>
            <span style="flex:1; height:1px; background:var(--nox-border)"></span>
            <span style="font:10px var(--nox-mono); color:var(--nox-muted)">P1 CYAN vs P2 PINK • idle / dash / shoot</span>
          </div>

          <div class="mock-grid">
            <!-- A -->
            <div class="mock-card mock-card--a">
              <div class="mock-variant-label">A // RAZOR</div>
              <div class="player-row-mock">
                <div class="player-mock">
                  <svg viewBox="0 0 80 80" width="84" height="84"><g transform="translate(40,40)"><ellipse cx="2" cy="14" rx="14" ry="5" fill="rgba(0,0,0,0.35)"/><path d="M 18 0 L -10 -8 L -6 0 L -10 8 Z" fill="#3ec5f2" stroke="#fff" stroke-width="1.6" stroke-linejoin="round"/><circle cx="0" cy="0" r="5" fill="#fff"/><circle cx="1" cy="-0.8" r="1.8" fill="#58d8ff"/><path d="M -6 -2 L -6 2" stroke="rgba(255,255,255,0.9)" stroke-width="1.2"/></g></svg>
                  <span class="mock-cap">P1 idle</span>
                </div>
                <div class="player-mock">
                  <svg viewBox="0 0 80 80" width="84" height="84"><g transform="translate(40,40)"><path d="M 18 0 L -10 -8 L -6 0 L -10 8 Z" fill="#3ec5f2" stroke="#fff" stroke-width="1.6" stroke-linejoin="round"/><circle cx="0" cy="0" r="5" fill="#fff"/><path d="M -10 0 L -22 -5 L -24 0 L -22 5 Z" fill="#a9e9ff" opacity="0.95"/><path d="M -12 -2 L -18 -4 M -12 2 L -18 4" stroke="#58d8ff" stroke-width="1.2" opacity="0.7"/></g></svg>
                  <span class="mock-cap">dash - twin jet</span>
                </div>
                <div class="player-mock">
                  <svg viewBox="0 0 80 80" width="84" height="84"><g transform="translate(40,40)"><path d="M 18 0 L -10 -8 L -6 0 L -10 8 Z" fill="#3ec5f2" stroke="#fff" stroke-width="1.6"/><circle cx="0" cy="0" r="5" fill="#fff"/><g transform="translate(18,0)"><path d="M -4 -4 L 4 0 L -4 4 Z" fill="#fff" stroke="#58d8ff" stroke-width="1.2"/><circle cx="0" cy="0" r="1.2" fill="#58d8ff"/><g opacity="0.9"><path d="M 4 0 L 18 0" stroke="#fff" stroke-width="1.2"/><circle cx="10" cy="0" r="1" fill="#fff"/><circle cx="16" cy="0" r="0.7" fill="#fff" opacity="0.7"/></g></g></g></svg>
                  <span class="mock-cap">shoot - star muzzle</span>
                </div>
              </div>
              <div class="player-row-mock">
                <div class="player-mock">
                  <svg viewBox="0 0 80 80" width="84" height="84"><g transform="translate(40,40)"><ellipse cx="2" cy="14" rx="14" ry="5" fill="rgba(0,0,0,0.35)"/><path d="M 18 0 L -10 -8 L -6 0 L -10 8 Z" fill="#f43f5e" stroke="#fff" stroke-width="1.6" stroke-linejoin="round"/><circle cx="0" cy="0" r="5" fill="#fff"/><circle cx="1" cy="-0.8" r="1.8" fill="#ff5ca8"/></g></svg>
                  <span class="mock-cap">P2 idle</span>
                </div>
                <div class="player-mock"><svg viewBox="0 0 80 80" width="84" height="84"><g transform="translate(40,40)"><path d="M 18 0 L -10 -8 L -6 0 L -10 8 Z" fill="#f43f5e" stroke="#fff" stroke-width="1.6"/><circle cx="0" cy="0" r="5" fill="#fff"/><path d="M -10 0 L -22 -5 L -24 0 L -22 5 Z" fill="#ff9ec9" opacity="0.95"/></g></svg><span class="mock-cap">dash</span></div>
                <div class="player-mock"><svg viewBox="0 0 80 80" width="84" height="84"><g transform="translate(40,40)"><path d="M 18 0 L -10 -8 L -6 0 L -10 8 Z" fill="#f43f5e" stroke="#fff" stroke-width="1.6"/><circle cx="0" cy="0" r="5" fill="#fff"/><g transform="translate(18,0)"><path d="M -3 -3 L 3 -1 L 3 1 L -3 3 Z" fill="#fff" stroke="#ff5ca8" stroke-width="1.2"/><circle cx="14" cy="0" r="2.2" fill="#fff" opacity="0.95"/><circle cx="14" cy="0" r="1" fill="#ff5ca8"/></g></g></svg><span class="mock-cap">slug</span></div>
              </div>
              <div class="mock-note">Hairline 1.6px, chamfer hull, white cockpit ring, vector muzzle 6-star. No emoji, 100% SVG.</div>
            </div>

            <!-- B -->
            <div class="mock-card mock-card--b">
              <div class="mock-variant-label" style="color:var(--nox-lime); border-color:rgba(201,255,47,0.3)">B // PLASMA</div>
              <div class="player-row-mock">
                <div class="player-mock">
                  <svg viewBox="0 0 80 80" width="84" height="84"><g transform="translate(40,40)"><ellipse cx="0" cy="14" rx="13" ry="5" fill="rgba(0,0,0,0.35)"/><path d="M 0 -15 L 11 -7 L 11 7 L 0 15 L -11 7 L -11 -7 Z" fill="none" stroke="#58d8ff" stroke-width="1.8"/><path d="M 0 -12 L 9 -6 L 9 6 L 0 12 L -9 6 L -9 -6 Z" fill="#0f1f25" stroke="rgba(88,216,255,0.6)" stroke-width="1"/><circle cx="0" cy="0" r="4.2" fill="#fff"/><circle cx="0" cy="0" r="7.5" fill="none" stroke="#58d8ff" stroke-width="1" stroke-dasharray="3 4" opacity="0.7"/><circle cx="0" cy="0" r="2.2" fill="#58d8ff" opacity="0.95"/></g></svg>
                  <span class="mock-cap">P1 hex - orbit ring</span>
                </div>
                <div class="player-mock">
                  <svg viewBox="0 0 80 80" width="84" height="84"><g transform="translate(40,40)"><path d="M 0 -15 L 11 -7 L 11 7 L 0 15 L -11 7 L -11 -7 Z" fill="none" stroke="#58d8ff" stroke-width="1.8"/><circle cx="0" cy="0" r="4.2" fill="#fff"/><circle cx="0" cy="0" r="10" fill="none" stroke="#58d8ff" stroke-width="1.2" opacity="0.35"/><g opacity="0.9"><ellipse cx="-14" cy="0" rx="6" ry="2.2" fill="#a9e9ff"/><ellipse cx="-14" cy="0" rx="3" ry="1" fill="#fff" opacity="0.9"/></g></g></svg>
                  <span class="mock-cap">dash - bloom thrust</span>
                </div>
                <div class="player-mock">
                  <svg viewBox="0 0 80 80" width="84" height="84"><g transform="translate(40,40)"><path d="M 0 -15 L 11 -7 L 11 7 L 0 15 L -11 7 L -11 -7 Z" fill="none" stroke="#58d8ff" stroke-width="1.2" opacity="0.8"/><circle cx="0" cy="0" r="4.2" fill="#fff"/><g transform="translate(12,0)"><circle cx="6" cy="0" r="3" fill="#fff" stroke="#58d8ff" stroke-width="1.4"/><circle cx="6" cy="0" r="1.2" fill="#58d8ff"/><circle cx="14" cy="0" r="6" fill="none" stroke="#58d8ff" stroke-width="0.8" opacity="0.35"/><circle cx="14" cy="0" r="1.4" fill="#a9e9ff" opacity="0.9"/></g></g></svg>
                  <span class="mock-cap">orb shot - 2-stage</span>
                </div>
              </div>
              <div class="player-row-mock">
                <div class="player-mock"><svg viewBox="0 0 80 80" width="84" height="84"><g transform="translate(40,40)"><path d="M 0 -15 L 11 -7 L 11 7 L 0 15 L -11 7 L -11 -7 Z" fill="none" stroke="#ff5ca8" stroke-width="1.8"/><circle cx="0" cy="0" r="4.2" fill="#fff"/><circle cx="0" cy="0" r="2.2" fill="#ff5ca8"/></g></svg><span class="mock-cap">P2 hex</span></div>
                <div class="player-mock"><svg viewBox="0 0 80 80" width="84" height="84"><g transform="translate(40,40)"><path d="M 0 -15 L 11 -7 L 11 7 L 0 15 L -11 7 L -11 -7 Z" fill="none" stroke="#ff5ca8" stroke-width="1.8"/><g opacity="0.9"><ellipse cx="-14" cy="0" rx="6" ry="2.2" fill="#ff9ec9"/></g></g></svg><span class="mock-cap">thrust</span></div>
                <div class="player-mock"><svg viewBox="0 0 80 80" width="84" height="84"><g transform="translate(40,40)"><circle cx="18" cy="0" r="4.5" fill="#fff" stroke="#ff5ca8" stroke-width="1.4"/><circle cx="18" cy="0" r="2" fill="#ff5ca8"/><circle cx="10" cy="0" r="1.2" fill="#fff" opacity="0.7"/></g></svg><span class="mock-cap">plasma</span></div>
              </div>
              <div class="mock-note">Inner glow, soft bloom, orbit ring. Feels like shielded drone. Most readable at 60fps.</div>
            </div>

            <!-- C -->
            <div class="mock-card mock-card--c">
              <div class="mock-variant-label" style="color:var(--nox-pink); border-color:rgba(255,92,168,0.3)">C // FORGE</div>
              <div class="player-row-mock">
                <div class="player-mock">
                  <svg viewBox="0 0 80 80" width="84" height="84"><g transform="translate(40,40)"><rect x="-14" y="-11" width="28" height="22" rx="2" fill="#0f1a1e" stroke="#58d8ff" stroke-width="2"/><rect x="-14" y="-11" width="28" height="5" rx="1" fill="#58d8ff" opacity="0.95"/><rect x="-10" y="2" width="10" height="6" rx="1" fill="#fff"/><rect x="6" y="-3" width="10" height="6" rx="1" fill="#58d8ff"/><circle cx="10" cy="0" r="1.4" fill="#0f1a1e"/></g></svg>
                  <span class="mock-cap">P1 block - heavy 2px</span>
                </div>
                <div class="player-mock">
                  <svg viewBox="0 0 80 80" width="84" height="84"><g transform="translate(40,40)"><rect x="-14" y="-11" width="28" height="22" rx="2" fill="#0f1a1e" stroke="#58d8ff" stroke-width="2"/><rect x="-20" y="-4" width="8" height="8" rx="1" fill="#58d8ff"/><rect x="-20" y="-2" width="8" height="3" fill="#fff" opacity="0.85"/></g></svg>
                  <span class="mock-cap">dash - exhaust block</span>
                </div>
                <div class="player-mock">
                  <svg viewBox="0 0 80 80" width="84" height="84"><g transform="translate(40,40)"><rect x="-14" y="-11" width="28" height="22" rx="2" fill="#0f1a1e" stroke="#fff" stroke-width="1.6"/><rect x="12" y="-4" width="10" height="8" rx="1" fill="#fff" stroke="#58d8ff" stroke-width="1.6"/><line x1="22" x2="30" y1="0" y2="0" stroke="#fff" stroke-width="2"/><rect x="28" y="-1.5" width="4" height="3" fill="#58d8ff"/></g></svg>
                  <span class="mock-cap">slug - square flash</span>
                </div>
              </div>
              <div class="player-row-mock">
                <div class="player-mock"><svg viewBox="0 0 80 80" width="84" height="84"><g transform="translate(40,40)"><rect x="-14" y="-11" width="28" height="22" rx="2" fill="#0f1a1e" stroke="#ff5ca8" stroke-width="2"/><rect x="-14" y="-11" width="28" height="5" fill="#ff5ca8"/></g></svg><span class="mock-cap">P2 block</span></div>
                <div class="player-mock"><svg viewBox="0 0 80 80" width="84" height="84"><g transform="translate(40,40)"><rect x="-14" y="-11" width="28" height="22" rx="2" fill="#0f1a1e" stroke="#ff5ca8" stroke-width="2"/><rect x="-20" y="-4" width="8" height="8" fill="#ff5ca8"/></g></svg><span class="mock-cap">thrust</span></div>
                <div class="player-mock"><svg viewBox="0 0 80 80" width="84" height="84"><g transform="translate(40,40)"><rect x="12" y="-4" width="12" height="8" fill="#f43f5e" stroke="#fff" stroke-width="1.6"/><circle cx="28" cy="0" r="3" fill="#fff"/></g></svg><span class="mock-cap">heavy</span></div>
              </div>
              <div class="mock-note">Industrial, pixel-snapped, thick stroke. Reads best on mobile, most brutal.</div>
            </div>
          </div>
        </section>

        <!-- 02 BUFFS -->
        <section class="mock-section">
          <div style="display:flex; align-items:center; gap:12px; margin:28px 0 16px; border-top:1px solid var(--nox-border); padding-top:22px">
            <span style="font:10px var(--nox-mono); letter-spacing:0.16em; color:var(--nox-pink)">02 // BUFFS // ORBS</span>
            <span style="flex:1; height:1px; background:var(--nox-border)"></span>
            <span style="font:10px var(--nox-mono); color:var(--nox-muted)">over // shield // blink // heal - no emojis</span>
          </div>

          <div class="mock-grid">
            <div class="mock-card mock-card--a">
              <div class="mock-variant-label">A // RAZOR</div>
              <div class="orb-grid-mock">
                <div class="orb-mock"><svg viewBox="0 0 40 40" width="40" height="40"><circle cx="20" cy="20" r="13" fill="#ff9d2e" stroke="#fff" stroke-width="1.6"/><path d="M 14 11 L 9 20 L 14 20 L 11 29 L 22 18 L 17 18 L 22 11 Z" fill="#fff"/><circle cx="20" cy="20" r="18" fill="none" stroke="#ffb23e" stroke-width="0.8" stroke-dasharray="2 3" opacity="0.5"/></svg><span>TRI</span></div>
                <div class="orb-mock"><svg viewBox="0 0 40 40" width="40" height="40"><circle cx="20" cy="20" r="13" fill="#3ec5f2" stroke="#fff" stroke-width="1.6"/><path d="M 20 11 L 13 16 L 13 24 L 20 29 L 27 24 L 27 16 Z" fill="none" stroke="#fff" stroke-width="1.6" stroke-linejoin="round"/><path d="M 20 15 L 20 21 M 20 24 L 20 25" stroke="#fff" stroke-width="1.4" stroke-linecap="round"/></svg><span>SHLD</span></div>
                <div class="orb-mock"><svg viewBox="0 0 40 40" width="40" height="40"><circle cx="20" cy="20" r="13" fill="#c9ff2f" stroke="#0f1a1e" stroke-width="1.4"/><path d="M 20 9 L 23 17 L 31 20 L 23 23 L 20 31 L 17 23 L 9 20 L 17 17 Z" fill="#0f1a1e"/><circle cx="20" cy="20" r="1.2" fill="#fff"/></svg><span>BLNK</span></div>
                <div class="orb-mock"><svg viewBox="0 0 40 40" width="40" height="40"><circle cx="20" cy="20" r="13" fill="#16a34a" stroke="#fff" stroke-width="1.6"/><path d="M 20 13 L 20 27 M 13 20 L 27 20" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/></svg><span>HEAL</span></div>
              </div>
              <div class="mock-note">1.6px stroke, white icon on solid fill, 2px inner ring, 3 orbiting dots vector.</div>
            </div>

            <div class="mock-card mock-card--b">
              <div class="mock-variant-label" style="color:var(--nox-lime); border-color:rgba(201,255,47,0.3)">B // PLASMA</div>
              <div class="orb-grid-mock">
                <div class="orb-mock"><svg viewBox="0 0 40 40" width="40" height="40"><circle cx="20" cy="20" r="16" fill="rgba(255,157,46,0.18)" stroke="none"/><circle cx="20" cy="20" r="11" fill="#ff9d2e" stroke="#fff" stroke-width="1.2"/><path d="M 14 12 L 10 20 L 15 20 L 12 28 L 21 18 L 16 18 L 21 12 Z" fill="#fff" opacity="0.98"/><circle cx="20" cy="20" r="15" fill="none" stroke="#ffb23e" stroke-width="0.6" opacity="0.35"/></svg><span>TRI</span></div>
                <div class="orb-mock"><svg viewBox="0 0 40 40" width="40" height="40"><circle cx="20" cy="20" r="16" fill="rgba(62,197,242,0.15)"/><circle cx="20" cy="20" r="11" fill="#3ec5f2" stroke="#fff" stroke-width="1.2"/><path d="M 20 12 L 14 16 L 14 24 L 20 28 L 26 24 L 26 16 Z" fill="rgba(255,255,255,0.92)" stroke="#fff" stroke-width="1.1"/></svg><span>SHLD</span></div>
                <div class="orb-mock"><svg viewBox="0 0 40 40" width="40" height="40"><circle cx="20" cy="20" r="16" fill="rgba(201,255,47,0.14)"/><circle cx="20" cy="20" r="11" fill="#c9ff2f"/><path d="M 20 10 L 22 18 L 30 20 L 22 22 L 20 30 L 18 22 L 10 20 L 18 18 Z" fill="#0f1a1e"/></svg><span>BLNK</span></div>
                <div class="orb-mock"><svg viewBox="0 0 40 40" width="40" height="40"><circle cx="20" cy="20" r="16" fill="rgba(22,163,74,0.15)"/><circle cx="20" cy="20" r="11" fill="#16a34a" stroke="#fff" stroke-width="1.2"/><path d="M 20 15 L 20 25 M 15 20 L 25 20" stroke="#fff" stroke-width="2" stroke-linecap="round"/><circle cx="20" cy="20" r="2" fill="#fff" opacity="0.9"/></svg><span>HEAL</span></div>
              </div>
              <div class="mock-note">16px outer bloom, inner glow, soft edge. Most premium, slightly larger.</div>
            </div>

            <div class="mock-card mock-card--c">
              <div class="mock-variant-label" style="color:var(--nox-pink); border-color:rgba(255,92,168,0.3)">C // FORGE</div>
              <div class="orb-grid-mock">
                <div class="orb-mock"><svg viewBox="0 0 40 40" width="40" height="40"><rect x="7" y="7" width="26" height="26" rx="3" fill="#ff9d2e" stroke="#fff" stroke-width="1.8"/><path d="M 15 10 L 11 18 L 15 18 L 12 26 L 20 18 L 16 18 L 20 10 Z" fill="#fff"/><rect x="7" y="7" width="26" height="4" rx="1" fill="#fff" opacity="0.9"/></svg><span>TRI</span></div>
                <div class="orb-mock"><svg viewBox="0 0 40 40" width="40" height="40"><rect x="7" y="7" width="26" height="26" rx="3" fill="#0f1a1e" stroke="#58d8ff" stroke-width="1.8"/><path d="M 20 11 L 12 16 L 12 24 L 20 29 L 28 24 L 28 16 Z" fill="none" stroke="#58d8ff" stroke-width="1.8"/></svg><span>SHLD</span></div>
                <div class="orb-mock"><svg viewBox="0 0 40 40" width="40" height="40"><rect x="7" y="7" width="26" height="26" rx="3" fill="#c9ff2f" stroke="#0f1a1e" stroke-width="1.6"/><path d="M 20 12 L 22 19 L 29 20 L 22 21 L 20 28 L 18 21 L 11 20 L 18 19 Z" fill="#0f1a1e"/></svg><span>BLNK</span></div>
                <div class="orb-mock"><svg viewBox="0 0 40 40" width="40" height="40"><rect x="7" y="7" width="26" height="26" rx="3" fill="#16a34a" stroke="#fff" stroke-width="1.8"/><path d="M 20 14 L 20 26 M 14 20 L 26 20" stroke="#fff" stroke-width="2.4"/></svg><span>HEAL</span></div>
              </div>
              <div class="mock-note">Square 3px radius, 1.8px block stroke, top highlight. Most legible.</div>
            </div>
          </div>
        </section>

        <!-- 03 DEBUFFS -->
        <section class="mock-section">
          <div style="display:flex; align-items:center; gap:12px; margin:28px 0 16px; border-top:1px solid var(--nox-border); padding-top:22px">
            <span style="font:10px var(--nox-mono); letter-spacing:0.16em; color:var(--nox-amber)">03 // DEBUFFS // HAZARDS</span>
            <span style="flex:1; height:1px; background:var(--nox-border)"></span>
            <span style="font:10px var(--nox-mono); color:var(--nox-muted)">lava / vent / slime / wall • now crisp</span>
          </div>

          <div class="mock-grid">
            <div class="mock-card mock-card--a">
              <div class="mock-variant-label">A // RAZOR</div>
              <div class="haz-grid">
                <div class="haz-mock"><svg viewBox="0 0 80 60" width="80" height="60"><path d="M 12 12 L 68 12 L 62 48 L 18 48 Z" fill="#1a0b0e" stroke="#dc2626" stroke-width="1.2"/><path d="M 20 18 L 60 18 L 56 42 L 22 42 Z" fill="#7c2d12"/><path d="M 28 24 Q 32 20 38 24 T 52 26 Q 40 32 30 28 Z" fill="#fb923c" opacity="0.9"/><text x="40" y="52" text-anchor="middle" font-size="6" font-family="monospace" fill="#fb923c">LAVA</text></svg><span>LAVA - cracked vent</span></div>
