---
// Online 1v1 — same GameShell flow as /play/1v1; the lobby replaces the start
// overlay and server snapshots drive the existing SVG render pipeline.
import '../../styles/global.css';
import GameShell from '../../components/GameShell';
import SEO from '../../components/SEO.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO
      title="NOX // Online 1V1 - guest matchmaking, no login"
      description="NOX online 1v1 arena. Quick match or private room codes. Guest identity, no signup."
      canonical="/play/online"
    />
    <slot name="head" />
  </head>
  <body>
    <GameShell client:load mode="online" />
  </body>
</html>

<style>
  /* Lobby card — reuses site tokens; injected above the stage overlay layer */
  #noxLobby { z-index: 60; }
  #noxLobby .menu-card { width: min(430px, 92vw); padding: 28px 26px; }
  #noxLobby .lob-row { display: flex; gap: 10px; margin-top: 14px; }
  #noxLobby input { flex: 1; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.15); color: var(--nox-fg, #fff); font: 13px var(--nox-mono, monospace); padding: 10px 12px; border-radius: 6px; }
  #noxLobby input:focus { outline: 1px solid var(--nox-lime, #c9ff2f); }
  #noxLobby .code-input { text-transform: uppercase; letter-spacing: 0.3em; max-width: 130px; }
  #noxLobby .lob-status { min-height: 1.3em; margin-top: 12px; color: var(--nox-muted, #9aa); font: 12px var(--nox-mono, monospace); }
  #noxLobby .lob-error { min-height: 1.3em; margin-top: 6px; color: #ff5470; font: 12px var(--nox-mono, monospace); }
  #noxLobby .room-code { letter-spacing: 0.35em; color: var(--nox-lime, #c9ff2f); font-size: 1.3rem; user-select: all; }
  #noxLobby .share-link { font: 11px var(--nox-mono, monospace); opacity: 0.7; user-select: all; word-break: break-all; }
  #noxLobby .seat-line { margin: 10px 0 0; font: 12px var(--nox-mono, monospace); color: var(--nox-fg, #fff); }
</style>

<script>
  import { NetBridge, getNick, setNick } from '../../game/net/net-bridge.js';
  import {
    startOnlineMatch, applyNetSnapshot, onlineResume, stopOnlineMatch,
  } from '../../game/game-logic.js';

  const $ = (id: string) => document.getElementById(id)!;
  const bridge = new NetBridge();
  const WS_BASE =
    (import.meta as unknown as { env: Record<string, string | undefined> }).env.PUBLIC_WS_URL ||
    (location.protocol === 'https:' ? 'wss://' + location.host : 'ws://' + location.host);

  let roomCode: string | null = null;
  let mySeat = 0;
  let rematchAsked = false;

  // ---------- lobby DOM (site-styled overlay inside the stage) ----------
  function buildLobby(): HTMLElement {
    let el = $('noxLobby');
    if (el) return el;
    el = document.createElement('div');
    el.id = 'noxLobby';
    el.className = 'overlay';
    el.innerHTML = `
      <div class="menu-card">
        <div class="badge" style="display:inline-block;border:1px solid rgba(88,216,255,.4);color:#58d8ff;font:10px var(--nox-mono,monospace);letter-spacing:.15em;padding:4px 10px;border-radius:4px;">ONLINE // GUEST // NO LOGIN</div>
        <h2 class="menu-title" style="margin-top:16px;">ONLINE 1V1</h2>
        <p style="color:var(--nox-muted,#9aa);font:12px var(--nox-mono,monospace);line-height:1.6;">First to 5 wins the void. Quick match or share a room code.</p>
        <div class="lob-row">
          <input id="noxNick" maxlength="16" placeholder="NICKNAME (2-16)" autocomplete="off" />
        </div>
        <div class="lob-row">
          <button class="btn btn-primary" id="noxQuick" style="flex:1;">QUICK MATCH</button>
          <button class="btn" id="noxCreate">CREATE ROOM</button>
        </div>
        <div class="lob-row">
          <input class="code-input" id="noxJoinCode" maxlength="5" placeholder="CODE" autocomplete="off" />
          <button class="btn" id="noxJoin">JOIN</button>
        </div>
        <p class="lob-status" id="noxStatus" role="status"></p>
        <p class="lob-error" id="noxError" role="alert"></p>
        <div id="noxRoomInfo" hidden>
          <p class="seat-line">ROOM CODE: <strong class="room-code" id="noxRoomCode"></strong></p>
          <p class="seat-line" id="noxSeats"></p>
          <p class="share-link" id="noxShare"></p>
          <div class="lob-row"><button class="btn btn-ghost" id="noxLeave">LEAVE ROOM</button></div>
        </div>
      </div>`;
    document.getElementById('stage')?.appendChild(el);

    const input = el.querySelector('#noxNick') as HTMLInputElement;
    input.value = getNick();

    el.querySelector('#noxQuick')!.addEventListener('click', () => run('quick'));
    el.querySelector('#noxCreate')!.addEventListener('click', () => run('create'));
    el.querySelector('#noxJoin')!.addEventListener('click', () => {
      const code = (el.querySelector('#noxJoinCode') as HTMLInputElement).value.trim().toUpperCase();
      if (code.length !== 5) { lobbyError('Room code is 5 characters.'); return; }
      run('join', code);
    });
    el.querySelector('#noxLeave')!.addEventListener('click', () => { bridge.send('leave'); showLobby(); });
    return el;
  }

  const lobbyError = (m: string) => { const e = $('noxError'); if (e) e.textContent = m; };
  const lobbyStatus = (m: string) => { const s = $('noxStatus'); if (s) s.textContent = m; };

  async function run(kind: 'quick' | 'create' | 'join', code?: string) {
    lobbyError('');
    const nick = ($('noxNick') as HTMLInputElement).value.trim();
    if (nick.length < 2) { lobbyError('Nickname must be 2-16 characters.'); return; }
    setNick(nick);
    lobbyStatus('CONNECTING…');
    try {
      if (!bridge.authed) await bridge.connect(WS_BASE + '/ws');
    } catch {
      lobbyError('Cannot reach the game server. It deploys on Render — see /play/online notes.');
      return;
    }
    lobbyStatus(kind === 'quick' ? 'SEARCHING…' : '…');
    bridge.send(kind, code ? { code } : {});
  }

  function showLobby() {
    stopOnlineMatch();
    roomCode = null;
    buildLobby().classList.remove('hidden');
    lobbyStatus('');
  }

  function hideLobby() { buildLobby().classList.add('hidden'); }

  function showRoom(msg: { code: string; seats: Array<{ nick: string } | null>; youSeat: number }) {
    $('noxRoomInfo').hidden = false;
    $('noxRoomCode').textContent = msg.code;
    $('noxSeats').textContent = msg.seats.every(Boolean)
      ? 'VS ' + (msg.seats[1 - msg.youSeat]?.nick ?? '?') + ' — starting…'
      : 'WAITING FOR OPPONENT…';
    const link = new URL(location.href); link.search = '?room=' + msg.code;
    $('noxShare').textContent = link.href;
  }

  // ---------- net -> game wiring ----------
  bridge.on('room', (msg: { code: string; youSeat: number; seats: Array<{ nick: string } | null>; seed: number }) => {
    roomCode = msg.code;
    mySeat = msg.youSeat;
    rematchAsked = false;
    showRoom(msg);
  });

  bridge.on('roomError', (m: { reason?: string }) => {
    lobbyError(m.reason || 'Room error.');
    lobbyStatus('');
  });

  bridge.on('queued', (m: { position: number }) => lobbyStatus('SEARCHING… POSITION ' + m.position));

  bridge.on('countdown', (m: { t: number }) => {
    if (m.t === 0 && roomCode) {
      hideLobby();
      const go = document.getElementById('gameOverOverlay');
      if (go) go.classList.add('hidden');
      onlineResume();
    }
  });

  bridge.on('snapshot', (m: { state: string }) => {
    applyNetSnapshot(m);
    if (m.state === 'playing') {
      const ro = document.getElementById('roundOverlay');
      if (ro && roomCode) ro.classList.add('hidden');
    }
  });

  bridge.on('roundEnd', () => { /* roundOverlay shown by game-logic endRound via snapshot state */ });

  bridge.on('matchEnd', () => {
    // GameOverOverlay was raised by endRound (scores >= 5) — offer rematch via shell button
    rematchAsked = false;
  });

  bridge.on('rematchReq', () => lobbyStatus('OPPONENT WANTS A REMATCH — PRESS REMATCH'));

  bridge.on('peerLeft', (m: { graceMs?: number }) => {
    lobbyStatus('OPPONENT LEFT — ' + Math.round((m.graceMs ?? 20000) / 1000) + 's GRACE');
  });

  bridge.on('peerBack', () => lobbyStatus(''));

  bridge.on('disconnected', () => {
    if (roomCode) {
      let tries = 0;
      const retry = async () => {
        if (tries++ >= 3 || bridge.authed) return;
        try { await bridge.connect(WS_BASE + '/ws'); } catch { setTimeout(retry, 1500); return; }
        bridge.send('join', { code: roomCode! });
      };
      setTimeout(retry, 1200);
    }
  });

  window.addEventListener('nox:onlineRematch', () => {
    if (rematchAsked) return;
    rematchAsked = true;
    bridge.send('rematchReq');
  });

  window.addEventListener('nox:forfeit', () => {
    if (roomCode) bridge.send('forfeit');
    bridge.send('leave');
    showLobby();
  });

  // ---------- input: P0 keys -> 6-bit mask @30Hz ----------
  const INPUT = { up: false, down: false, left: false, right: false, dash: false, shoot: false };
  const KEYMAP: Record<string, keyof typeof INPUT> = {
    KeyW: 'up', KeyS: 'down', KeyA: 'left', KeyD: 'right', ShiftLeft: 'dash', Space: 'shoot',
  };
  addEventListener('keydown', (e) => { const k = KEYMAP[e.code]; if (k) { INPUT[k] = true; if (e.code === 'Space') e.preventDefault(); } });
  addEventListener('keyup', (e) => { const k = KEYMAP[e.code]; if (k) INPUT[k] = false; });

  let inputSeq = 0;
  setInterval(() => {
    if (!bridge.authed || !roomCode) return;
    const m = (INPUT.up ? 1 : 0) | (INPUT.down ? 2 : 0) | (INPUT.left ? 4 : 0)
      | (INPUT.right ? 8 : 0) | (INPUT.dash ? 16 : 0) | (INPUT.shoot ? 32 : 0);
    bridge.send('input', { seq: ++inputSeq, m });
  }, 1000 / 30);

  // boot: lobby replaces the local start overlay; deep-link ?room= joins directly
  function boot() {
    const so = document.getElementById('startOverlay');
    if (so) so.classList.add('hidden');
    buildLobby();
    const roomParam = new URLSearchParams(location.search).get('room');
    if (roomParam && /^[A-Z0-9]{5}$/i.test(roomParam)) {
      const input = $('noxNick') as HTMLInputElement;
      input.value = getNick() || input.value;
      ($('noxJoinCode') as HTMLInputElement).value = roomParam.toUpperCase();
      run('join', roomParam.toUpperCase());
    }
  }
  if (document.readyState === 'loading') addEventListener('DOMContentLoaded', boot); else boot();
</script>
