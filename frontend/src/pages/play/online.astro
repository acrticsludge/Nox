---
// Online 1v1 — same GameShell flow as /play/1v1; the lobby replaces the start
// overlay and server snapshots drive the existing SVG render pipeline.
import '../../styles/global.css';
import GameShell from '../../components/GameShell';
import SEO from '../../components/SEO.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO
      title="NOX // Online 1V1 - guest matchmaking, no login"
      description="NOX online 1v1 arena. Quick match or private room codes. Guest identity, no signup."
      canonical="/play/online"
    />
    <slot name="head" />
  </head>
  <body>
    <GameShell client:load mode="online" />
  </body>
</html>

<style is:global>
  /* is:global is required — the lobby/countdown/banner DOM is injected at
     runtime, so Astro's scoped style attribute never matches it */
  /* Lobby card — reuses site tokens; injected above the stage overlay layer */
  #noxLobby { z-index: 60; }
  #noxLobby .menu-card { width: min(430px, 92vw); padding: 28px 26px; }
  #noxLobby .lob-label { display: block; margin: 16px 0 6px; font: 10px var(--nox-mono, monospace); letter-spacing: 0.2em; color: var(--nox-muted, #9aa); text-align: left; }
  #noxLobby input { width: 100%; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.15); color: var(--nox-fg, #fff); font: 13px var(--nox-mono, monospace); padding: 10px 12px; border-radius: 6px; box-sizing: border-box; }
  #noxLobby input:focus { outline: 1px solid var(--nox-lime, #c9ff2f); }
  #noxLobby .code-input { text-transform: uppercase; letter-spacing: 0.3em; }
  #noxLobby .btn-row { display: flex; gap: 10px; width: 100%; justify-content: flex-start; }
  #noxLobby .btn-row .btn { white-space: nowrap; }
  #noxLobby .btn-row input { flex: 1; min-width: 0; }
  #noxLobby .lob-divider { margin: 18px 0 0; border: 0; border-top: 1px dashed rgba(255,255,255,0.12); }
  #noxLobby .lob-status { min-height: 1.3em; margin-top: 12px; color: var(--nox-muted, #9aa); font: 12px var(--nox-mono, monospace); }
  #noxLobby .lob-error { min-height: 1.3em; margin-top: 6px; color: #ff5470; font: 12px var(--nox-mono, monospace); }
  #noxLobby .room-code { letter-spacing: 0.35em; color: var(--nox-lime, #c9ff2f); font-size: 1.3rem; user-select: all; }
  #noxLobby .share-link { font: 11px var(--nox-mono, monospace); opacity: 0.7; user-select: all; word-break: break-all; }
  #noxLobby .seat-line { margin: 10px 0 0; font: 12px var(--nox-mono, monospace); color: var(--nox-fg, #fff); }
  #noxLobby .id-cyan { color: #58d8ff; }
  #noxLobby .id-pink { color: #ff2d78; }

  /* in-arena: big countdown modal + centered result modal */
  #noxCd { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; pointer-events: none; z-index: 55; }
  #noxCd span { display: inline-block; min-width: 190px; text-align: center; padding: 18px 34px; background: rgba(13,16,22,0.92); border: 1px solid rgba(201,255,47,0.45); border-radius: 10px; font: 700 clamp(44px, 8vw, 76px) var(--nox-mono, monospace); color: var(--nox-lime, #c9ff2f); text-shadow: 0 0 18px rgba(201,255,47,0.4); box-shadow: 0 0 40px rgba(0,0,0,0.6); }
  #noxMsg { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; pointer-events: none; z-index: 56; }
  #noxMsg span { display: inline-block; max-width: 80%; text-align: center; padding: 20px 30px; background: rgba(13,16,22,0.94); border: 1px solid rgba(255,178,62,0.5); border-radius: 10px; font: 700 clamp(16px, 2.6vw, 26px) var(--nox-mono, monospace); letter-spacing: 0.08em; color: var(--nox-amber, #ffb23e); box-shadow: 0 0 40px rgba(0,0,0,0.65); }
</style>

<script>
  import { NetBridge, getNick, setNick } from '../../game/net/net-bridge.js';

  // O1: the game engine is loaded ONLY when a match actually starts. Importing it
  // eagerly booted its rAF loop during the lobby -> mutated HUD DOM before React
  // hydration (hydration failure + 1v1 flash) and allowed arena input while queueing.
  let gl: typeof import('../../game/game-logic.js') | null = null;
  const engine = async () => {
    if (!gl) {
      gl = await import('../../game/game-logic.js');
      gl.bootEngine();   // T4: module import alone starts nothing
    }
    return gl;
  };

  const $ = (id: string) => document.getElementById(id)!;
  const bridge = new NetBridge();
  const WS_BASE =
    (import.meta as unknown as { env: Record<string, string | undefined> }).env.PUBLIC_WS_URL ||
    (location.protocol === 'https:' ? 'wss://' + location.host : 'ws://' + location.host);

  let roomCode: string | null = null;
  let mySeat = 0;
  let applyNickRef: () => void = () => {};

  // ---------- lobby DOM (site-styled overlay inside the stage) ----------
  function buildLobby(): HTMLElement {
    let el = $('noxLobby');
    if (el) return el;
    el = document.createElement('div');
    el.id = 'noxLobby';
    el.className = 'overlay';
    el.innerHTML = `
      <div class="menu-card">
        <div class="badge" style="display:inline-block;border:1px solid rgba(88,216,255,.4);color:#58d8ff;font:10px var(--nox-mono,monospace);letter-spacing:.15em;padding:4px 10px;border-radius:4px;">ONLINE // GUEST // NO LOGIN</div>
        <h2 class="menu-title" style="margin-top:16px;">ONLINE 1V1</h2>
        <p style="color:var(--nox-muted,#9aa);font:12px var(--nox-mono,monospace);line-height:1.6;">First to 5 wins the void. Quick match or share a room code.</p>
        <label class="lob-label" for="noxNick">NICKNAME</label>
        <input id="noxNick" maxlength="16" placeholder="2-16 CHARACTERS" autocomplete="off" />
        <div class="btn-row" style="margin-top:14px;">
          <button class="btn btn-primary" id="noxQuick" style="flex:1;">QUICK MATCH</button>
          <button class="btn" id="noxCreate">CREATE ROOM</button>
        </div>
        <hr class="lob-divider" />
        <label class="lob-label" for="noxJoinCode">HAVE A CODE?</label>
        <div class="btn-row">
          <input class="code-input" id="noxJoinCode" maxlength="5" placeholder="ABCDE" autocomplete="off" />
          <button class="btn" id="noxJoin">JOIN</button>
        </div>
        <p class="lob-status" id="noxStatus" role="status"></p>
        <p class="lob-error" id="noxError" role="alert"></p>
        <div id="noxRoomInfo" hidden>
          <p class="seat-line">ROOM <strong class="room-code" id="noxRoomCode"></strong></p>
          <p class="seat-line" id="noxIdentity"></p>
          <p class="seat-line" id="noxSeats"></p>
          <p class="share-link" id="noxShare"></p>
          <div class="btn-row" id="noxRematchRow" hidden>
            <button class="btn btn-primary" id="noxRematch" style="flex:1;">REMATCH</button>
          </div>
          <div class="btn-row"><button class="btn btn-ghost" id="noxLeave">LEAVE ROOM</button></div>
        </div>
      </div>`;
    document.getElementById('stage')?.appendChild(el);

    const input = el.querySelector('#noxNick') as HTMLInputElement;
    input.value = getNick();
    // HUD self card mirrors the nick live as it is typed; opponent stays empty
    // until a room pairs someone (empty state: —). Card follows your seat:
    // seat 0 renders in the cyan card, seat 1 in the pink card.
    const applyNick = () => {
      const self = document.querySelector(mySeat === 1 ? '#cardP2 .hud-name' : '#cardP1 .hud-name');
      if (self) self.textContent = input.value.trim().toUpperCase() || 'YOU';
    };
    applyNickRef = applyNick;
    input.addEventListener('input', applyNick);
    applyNick();

    el.querySelector('#noxQuick')!.addEventListener('click', () => run('quick'));
    el.querySelector('#noxCreate')!.addEventListener('click', () => run('create'));
    el.querySelector('#noxJoin')!.addEventListener('click', () => {
      const code = (el.querySelector('#noxJoinCode') as HTMLInputElement).value.trim().toUpperCase();
      if (code.length !== 5) { lobbyError('Room code is 5 characters.'); return; }
      run('join', code);
    });
    el.querySelector('#noxLeave')!.addEventListener('click', () => { bridge.send('leave'); bridge.reconnectCred = null; showLobby(); });
    el.querySelector('#noxRematch')!.addEventListener('click', () => {
      bridge.send('rematchReq');
      lobbyStatus('REMATCH REQUESTED — WAITING FOR OPPONENT…');
    });
    return el;
  }

  const lobbyError = (m: string) => { const e = $('noxError'); if (e) e.textContent = m; };
  const lobbyStatus = (m: string) => { const s = $('noxStatus'); if (s) s.textContent = m; };

  function lockLobby(v: boolean) {
    buildLobby().querySelectorAll('button').forEach((b) => { (b as HTMLButtonElement).disabled = v; });
  }

  async function run(kind: 'quick' | 'create' | 'join', code?: string) {
    lobbyError('');
    const nick = ($('noxNick') as HTMLInputElement).value.trim();
    if (nick.length < 2) { lobbyError('Nickname must be 2-16 characters.'); return; }
    setNick(nick);
    lockLobby(true);           // O5: no double-queue/double-join during a transition
    lobbyStatus('CONNECTING…');
    try {
      if (!bridge.authed) await bridge.connect(WS_BASE + '/ws');
      lobbyStatus(kind === 'quick' ? 'SEARCHING…' : '…');
      bridge.send(kind, code ? { code } : {});
    } catch {
      lockLobby(false);
      lobbyError('Cannot reach the game server. Is the backend running? (npm start in backend/)');
    }
  }

  // post-match: keep the session + room, show the room panel (rematch/leave)
  function showLobbyPanel() {
    const lob = buildLobby();
    lob.classList.remove('hidden');
    if (roomCode) { $('noxRoomInfo').hidden = false; }
  }

  function showLobby() {
    gl?.stopOnlineMatch();
    roomCode = null;
    setHud(false);
    const cd = document.getElementById('noxCd'); if (cd) cd.style.display = 'none';
    const msg = document.getElementById('noxMsg'); if (msg) msg.style.display = 'none';
    for (const sel of ['#cardP1 .hud-name', '#cardP2 .hud-name']) {
      const el = document.querySelector(sel);
      if (el) el.textContent = '—';
    }
    applyNickRef();
    const label = document.querySelector('#noxKeysBar .controls-label') as HTMLElement | null;
    if (label) { label.textContent = 'YOU // CYAN'; label.style.color = '#58d8ff'; }
    const lob = buildLobby();
    lob.classList.remove('hidden');
    $('noxRoomInfo').hidden = true;
    lockLobby(false);
    lobbyStatus('');
    lobbyError('');
  }

  function hideLobby() { buildLobby().classList.add('hidden'); }

  function showRoom(msg: { code: string; seats: Array<{ nick: string } | null>; youSeat: number }) {
    $('noxRoomInfo').hidden = false;
    $('noxRoomCode').textContent = msg.code;
    // identity is explicit BEFORE the match: seat 0 = cyan, seat 1 = pink
    const mine = msg.youSeat === 0 ? 'CYAN' : 'PINK';
    const theirs = msg.youSeat === 0 ? 'PINK' : 'CYAN';
    $('noxIdentity').innerHTML =
      'YOU ARE <strong class="' + (mine === 'CYAN' ? 'id-cyan' : 'id-pink') + '">' + mine + '</strong>' +
      ' // OPPONENT IS <strong class="' + (theirs === 'CYAN' ? 'id-cyan' : 'id-pink') + '">' + theirs + '</strong>';
    $('noxSeats').textContent = msg.seats.every(Boolean)
      ? 'VS ' + (msg.seats[1 - msg.youSeat]?.nick ?? '?').toUpperCase() + ' — starting…'
      : 'WAITING FOR OPPONENT…';
    // opponent card shows the remote player's nick (audit R1); keys label follows your color
    const opp = msg.seats[1 - msg.youSeat];
    const myCardSel = msg.youSeat === 1 ? '#cardP1 .hud-name' : '#cardP2 .hud-name';
    const oppName = document.querySelector(myCardSel);
    if (oppName) oppName.textContent = opp ? opp.nick.toUpperCase() : 'WAITING…';
    const label = document.querySelector('#noxKeysBar .controls-label') as HTMLElement | null;
    if (label) { label.textContent = 'YOU // ' + mine; label.style.color = mine === 'CYAN' ? '#58d8ff' : '#ff2d78'; }
    const link = new URL(location.href); link.search = '?room=' + msg.code;
    $('noxShare').textContent = link.href;
  }

  const stageMsg = (m: string, ms = 0) => {
    const el = document.getElementById('noxMsg');
    if (!el) return;
    el.innerHTML = '<span></span>';
    (el.firstChild as HTMLElement).textContent = m;
    el.style.display = m ? 'flex' : 'none';
    if (ms) setTimeout(() => { if (el.style.display !== 'none' && (el.firstChild as HTMLElement)?.textContent === m) el.style.display = 'none'; }, ms);
  };

  // HUD identity stays hidden until the server assigns seats (countdown start)
  const setHud = (v: boolean) => {
    for (const id of ['noxHudBar', 'noxKeysBar']) {
      const el = document.getElementById(id);
      if (el) el.style.display = v ? '' : 'none';
    }
  };

  const bigCount = (txt: string) => {
    const el = document.getElementById('noxCd');
    if (!el) return;
    el.innerHTML = '<span></span>';
    (el.firstChild as HTMLElement).textContent = txt;
    el.style.display = 'flex';
  };

  // ---------- net -> game wiring ----------
  bridge.on('room', async (msg: { code: string; youSeat: number; seats: Array<{ nick: string } | null>; seed: number; rematchWait?: boolean }) => {
    roomCode = msg.code;
    mySeat = msg.youSeat;
    showRoom(msg);
    lobbyStatus('');
    const row = document.getElementById('noxRematchRow');
    if (row) row.hidden = !msg.rematchWait;
    if (msg.rematchWait) {
      // Task 12: post-match room survives for mutual rematch — no engine, no ready
      lobbyStatus(msg.seats.every(Boolean) ? 'REMATCH? PRESS REMATCH WHEN READY' : 'WAITING FOR OPPONENT…');
      showLobbyPanel();
      return;
    }
    const g = await engine();
    g.startOnlineMatch(msg.seed);
    // server starts ticking only after ready from both seats (T7 protocol)
    if (msg.seats.every(Boolean)) bridge.send('ready');
  });

  bridge.on('roomClosed', () => {
    bridge.reconnectCred = null;
    showLobby();
    lobbyStatus('ROOM CLOSED');
  });

  bridge.on('rejoined', (m: { code: string; seat: number }) => {
    // Task 10: seat reclaimed after reconnect — wait for the fresh room broadcast
    stageMsg('RECONNECTED — SEAT ' + (m.seat === 0 ? 'CYAN' : 'PINK'));
    setTimeout(() => stageMsg(''), 2500);
  });

  bridge.on('roomError', (m: { reason?: string }) => {
    lockLobby(false);
    lobbyError(m.reason || 'Room error.');
    lobbyStatus('');
  });

  bridge.on('queued', (m: { position: number }) => lobbyStatus('SEARCHING… POSITION ' + m.position));

  bridge.on('countdown', async (m: { t: number }) => {
    if (!roomCode) return;
    if (m.t > 0) { setHud(true); setMatchLive(true); bigCount(String(m.t)); return; }
    hideLobby();
    bigCount('GO');
    setTimeout(() => { const el = document.getElementById('noxCd'); if (el && (el.firstChild as HTMLElement)?.textContent === 'GO') el.style.display = 'none'; }, 700);
    const g = await engine();
    g.onlineResume();
  });

  bridge.on('snapshot', async (m: { state: string }) => {
    const g = await engine();
    g.applyNetSnapshot(m);
    if (m.state === 'playing') {
      const ro = document.getElementById('roundOverlay');
      if (ro && roomCode) ro.classList.add('hidden');
    }
  });

  bridge.on('roundEnd', () => { resetInput(); /* roundOverlay shown by game-logic endRound via snapshot state */ });

  // match over (win, forfeit or disconnect): one result message, then a full
  // reset back to the lobby — the server has already destroyed the room
  bridge.on('matchEnd', (m: { winner: number | null; reason?: string }) => {
    setMatchLive(false);
    const win = m.winner === mySeat;
    const abandoned = /FORFEIT|DISCONNECT|LEFT/i.test(m.reason ?? '');
    const text = m.winner === null ? 'MATCH OVER'
      : abandoned ? (win ? 'OPPONENT LEFT — YOU WIN' : 'YOU LEFT — MATCH OVER')
      : win ? 'YOU WIN' : 'OPPONENT WINS';
    const g = gl; // engine is loaded by now (a match was running)
    g?.stopOnlineMatch();
    const sc = (m as { scores?: number[] }).scores;
    stageMsg(text + (sc ? `  //  ${sc[0]} — ${sc[1]}` : ''));
    setTimeout(() => { stageMsg(''); showLobbyPanel(); }, 2600);
  });

  bridge.on('peerLeft', (m: { graceMs?: number }) => {
    stageMsg('OPPONENT DISCONNECTED — REJOIN WITHIN ' + Math.round((m.graceMs ?? 20000) / 1000) + 's OR YOU WIN');
  });

  bridge.on('peerBack', () => stageMsg(''));

  bridge.on('disconnected', () => {
    setMatchLive(false);
    if (roomCode) {
      let tries = 0;
      const retry = async () => {
        if (tries++ >= 3 || bridge.authed) {
          if (!bridge.authed) { bridge.reconnectCred = null; showLobby(); lobbyError('Connection lost — could not rejoin the room.'); }
          return;
        }
        try { await bridge.connect(WS_BASE + '/ws'); } catch { setTimeout(retry, 1500); return; }
        // Task 10: present the signed seat credential when we hold one
        const cred = bridge.reconnectCred;
        bridge.send('join', cred && cred.roomCode === roomCode
          ? { code: roomCode, reconnect: { roomCode: cred.roomCode, seat: cred.seat, token: cred.token } }
          : { code: roomCode });
      };
      setTimeout(retry, 1200);
    }
  });

  window.addEventListener('nox:forfeit', () => {
    setMatchLive(false);
    if (roomCode) bridge.send('forfeit');
    bridge.send('leave');
    showLobby();
  });

  // ---------- input: P0 keys -> 6-bit mask @30Hz ----------
  // T6 input ownership: capture only while a match is live, never in text
  // fields, reset on blur/hidden/terminal transitions so keys never stick.
  const INPUT = { up: false, down: false, left: false, right: false, dash: false, shoot: false };
  const KEYMAP: Record<string, keyof typeof INPUT> = {
    KeyW: 'up', KeyS: 'down', KeyA: 'left', KeyD: 'right', ShiftLeft: 'dash', Space: 'shoot',
  };
  let matchLive = false;
  const setMatchLive = (v: boolean) => { matchLive = v; resetInput(); };
  const resetInput = () => { for (const k of Object.keys(INPUT) as Array<keyof typeof INPUT>) INPUT[k] = false; };
  const isTypingTarget = (t: EventTarget | null) =>
    t instanceof HTMLElement && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.tagName === 'SELECT' || t.isContentEditable);
  addEventListener('keydown', (e) => {
    const k = KEYMAP[e.code];
    if (!k || !matchLive || isTypingTarget(e.target)) return;
    INPUT[k] = true;
    if (e.code === 'Space') e.preventDefault();
  });
  addEventListener('keyup', (e) => {
    const k = KEYMAP[e.code];
    if (!k || isTypingTarget(e.target)) return;   // always honour releases
    INPUT[k] = false;
  });
  addEventListener('blur', resetInput);
  document.addEventListener('visibilitychange', () => { if (document.hidden) resetInput(); });

  let inputSeq = 0;
  setInterval(() => {
    // input packets only in 'playing' (spec: never during lobby/queue/round breaks)
    if (!bridge.authed || !roomCode || !matchLive || document.hidden) return;
    const m = (INPUT.up ? 1 : 0) | (INPUT.down ? 2 : 0) | (INPUT.left ? 4 : 0)
      | (INPUT.right ? 8 : 0) | (INPUT.dash ? 16 : 0) | (INPUT.shoot ? 32 : 0);
    bridge.send('input', { seq: ++inputSeq, m });
  }, 1000 / 30);

  // boot: wait for React hydration to finish (it rebuilds #stage), then hide the
  // local start overlay and mount the lobby. Observer on body re-asserts if React
  // ever re-renders the stage.
  // boot: after hydration settles, mount the lobby into the React-rendered
  // #noxLobbyMount (the 1v1 start overlay is never rendered in online mode)
  function inject() {
    const mount = document.getElementById('noxLobbyMount');
    if (!mount) return false;
    const stage = document.getElementById('stage');
    if (stage && !document.getElementById('noxCd')) {
      const cd = document.createElement('div');
      cd.id = 'noxCd'; cd.style.display = 'none';
      stage.appendChild(cd);
      const msg = document.createElement('div');
      msg.id = 'noxMsg'; msg.style.display = 'none';
      stage.appendChild(msg);
      const p2 = document.querySelector('#cardP2 .hud-name');
      if (p2) p2.textContent = '—';   // opponent slot empty until paired
    }
    if (!document.getElementById('noxLobby')) mount.appendChild(buildLobby());
    return true;
  }
  function boot() {
    if (!inject()) { setTimeout(boot, 150); return; }
    const roomParam = new URLSearchParams(location.search).get('room');
    if (roomParam && /^[A-Z0-9]{5}$/i.test(roomParam)) {
      const input = $('noxNick') as HTMLInputElement;
      input.value = getNick() || input.value;
      ($('noxJoinCode') as HTMLInputElement).value = roomParam.toUpperCase();
      run('join', roomParam.toUpperCase());
    }
    new MutationObserver(() => { inject(); })
      .observe(document.body, { childList: true, subtree: true });
  }
  // hydration replaces island DOM shortly after load — inject only after it settles
  addEventListener('load', () => setTimeout(boot, 900));
</script>
