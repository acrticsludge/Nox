---
// T6: Online 1v1 lobby — guest nick, Create/Join/Quick, room state, ping display.
// Standalone page; gameplay render bridge lands in T8.
import '../../styles/global.css';
import SEO from '../../components/SEO.astro';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO
      title="NOX // Online 1v1 - guest matchmaking, no login"
      description="NOX online 1v1 arena. Quick match or private room codes. Guest identity, no signup."
      canonical="/play/online"
    />
    <slot name="head" />
  </head>
  <body>
  <main id="online-root" class="online-root">
    <h1 class="online-title">ONLINE 1V1</h1>

    <section id="lobby" class="panel">
      <label class="field">
        <span class="field-label">NICKNAME</span>
        <input id="nick" maxlength="16" minlength="2" placeholder="2-16 chars" autocomplete="off" />
      </label>
      <div class="btn-row">
        <button id="btn-quick" class="btn btn-primary">QUICK MATCH</button>
        <button id="btn-create" class="btn">CREATE ROOM</button>
      </div>
      <div class="btn-row">
        <input id="join-code" maxlength="5" placeholder="CODE" class="code-input" autocomplete="off" />
        <button id="btn-join" class="btn">JOIN</button>
      </div>
      <p id="lobby-status" class="status" role="status"></p>
      <p id="conn-error" class="error" role="alert" hidden></p>
    </section>

    <section id="game-panel" class="panel game-panel" hidden>
      <canvas id="game-canvas" width="960" height="560"></canvas>
      <p id="game-status" class="status" role="status"></p>
      <button id="btn-forfeit" class="btn">FORFEIT</button>
    </section>

    <section id="room-panel" class="panel" hidden>
      <p class="room-code-line">ROOM CODE: <strong id="room-code" class="room-code"></strong></p>
      <p class="hint">Share: <span id="share-link" class="share-link"></span></p>
      <ul id="seats" class="seats"></ul>
      <p id="room-status" class="status" role="status"></p>
      <button id="btn-leave" class="btn">LEAVE</button>
    </section>
  </main>
  </body>
</html>

<style>
  .online-root { min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1.5rem; padding: 2rem 1rem; }
  .online-title { letter-spacing: 0.2em; }
  .panel { display: flex; flex-direction: column; gap: 0.9rem; width: min(420px, 100%); padding: 1.5rem; border: 1px solid var(--border, #333); border-radius: 10px; }
  .field, .btn-row { display: flex; gap: 0.6rem; }
  .field { flex-direction: column; }
  .field-label { font-size: 0.75rem; letter-spacing: 0.15em; opacity: 0.7; }
  input { padding: 0.6rem 0.8rem; border-radius: 6px; border: 1px solid var(--border, #444); background: transparent; color: inherit; }
  .code-input { text-transform: uppercase; letter-spacing: 0.3em; width: 8rem; }
  .btn { padding: 0.65rem 1rem; border-radius: 6px; border: 1px solid var(--border, #444); background: transparent; color: inherit; cursor: pointer; }
  .btn:disabled { opacity: 0.45; cursor: not-allowed; }
  .btn-primary { border-color: currentColor; font-weight: 700; }
  .status { min-height: 1.2em; opacity: 0.8; }
  .error { color: #ff5470; min-height: 1.2em; }
  .room-code { letter-spacing: 0.35em; font-size: 1.4rem; }
  .share-link { user-select: all; font-family: monospace; font-size: 0.8rem; opacity: 0.75; }
  .seats { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 0.35rem; }
  .game-panel { width: min(980px, 100%); }
  #game-canvas { width: 100%; border: 1px solid var(--border, #333); border-radius: 8px; }
</style>

<script>
  import { NetBridge, getNick, setNick } from '../../game/net/net-bridge.js';
  import { createMatch, W, H } from '../../game/sim/game-sim.js';

  const $ = (id) => document.getElementById(id);
  const bridge = new NetBridge();
  const wsUrl = (location.protocol === 'https:' ? 'wss://' : 'ws://') + location.host;

  // --- online match state ---
  let localMap = null;      // createMatch(seed) for walls/hazards drawing only
  let mySeat = 0;
  let roomCode = null;
  const INPUT = { up: false, down: false, left: false, right: false, dash: false, shoot: false };
  const KEYMAP = { KeyW: 'up', KeyS: 'down', KeyA: 'left', KeyD: 'right', ShiftLeft: 'dash', Space: 'shoot' };

  const COLORS = { standard: '#f1f4f3', needle: '#a78bfa', cannon: '#ffb23e', trick: '#58d8ff' };
  const PCOLORS = ['#58d8ff', '#ff5ca8'];

  function buildMap(seed) {
    localMap = createMatch(seed, {});
    // drop dynamic entities; keep walls/hazards for drawing
    localMap.players.length = 0; localMap.bullets.length = 0; localMap.pickups.length = 0; localMap.fx.length = 0;
  }

  function startGameView() {
    $('room-panel').hidden = true;
    $('game-panel').hidden = false;
    $('game-status').textContent = 'GET READY…';
    requestAnimationFrame(draw);
  }

  function endGameView() {
    $('game-panel').hidden = true;
    backToLobby();
  }

  // --- input: local keys -> server mask @30Hz ---
  addEventListener('keydown', e => { const k = KEYMAP[e.code]; if (k) { INPUT[k] = true; if (e.code === 'Space') e.preventDefault(); } });
  addEventListener('keyup', e => { const k = KEYMAP[e.code]; if (k) INPUT[k] = false; });

  let inputSeq = 0;
  setInterval(() => {
    if (!bridge.authed || roomCode === null) return;
    const mask = (INPUT.up ? 1 : 0) | (INPUT.down ? 2 : 0) | (INPUT.left ? 4 : 0)
      | (INPUT.right ? 8 : 0) | (INPUT.dash ? 16 : 0) | (INPUT.shoot ? 32 : 0);
    bridge.send('input', { seq: ++inputSeq, m: mask });
  }, 1000 / 30);

  // --- renderer ---
  const canvas = $('game-canvas');
  const ctx = canvas.getContext('2d');
  let lastSnap = null;

  function draw() {
    if ($('game-panel').hidden) return;
    requestAnimationFrame(draw);
    ctx.fillStyle = '#0a0c10';
    ctx.fillRect(0, 0, W, H);
    if (!localMap) return;
    ctx.fillStyle = '#2a2f38';
    for (const w of localMap.walls) ctx.fillRect(w.x, w.y, w.w, w.h);
    for (const hz of localMap.hazards) {
      ctx.fillStyle = hz.kind === 'lava' ? 'rgba(251,146,60,0.25)' : 'rgba(110,231,183,0.2)';
      ctx.fillRect(hz.x, hz.y, hz.w, hz.h);
    }
    // T9: interpolate rendering 100ms in the past between the last two snapshots
    let view = snapCur?.m ?? null;
    if (snapPrev && snapCur) {
      const alpha = Math.min(1, Math.max(0, 1 - (performance.now() - snapCur.t) / 100));
      const lerp = (a, b) => a + (b - a) * alpha;
      view = {
        ...snapCur.m,
        p: snapCur.m.p.map((p, i) => {
          const q = snapPrev.m.p[i] || p;
          return [lerp(q[0], p[0]), lerp(q[1], p[1]), p[2], p[3], p[4], p[5]];
        }),
        b: snapCur.m.b,
      };
    }
    lastSnap = view;
    if (!lastSnap) return;
    ctx.fillStyle = '#7dd3fc';
    for (const pk of lastSnap.pk) ctx.fillRect(pk[0] - 6, pk[1] - 6, 12, 12);
    for (const b of lastSnap.b) {
      ctx.fillStyle = COLORS[b[4]] || '#fff';
      ctx.beginPath(); ctx.arc(b[0], b[1], 4, 0, Math.PI * 2); ctx.fill();
    }
    lastSnap.p.forEach((p, i) => {
      ctx.fillStyle = PCOLORS[i];
      ctx.beginPath(); ctx.arc(p[0], p[1], 16, 0, Math.PI * 2); ctx.fill();
      ctx.strokeStyle = '#000'; ctx.lineWidth = 2;
      ctx.beginPath(); ctx.moveTo(p[0], p[1]);
      ctx.lineTo(p[0] + Math.cos(p[2]) * 16, p[1] + Math.sin(p[2]) * 16); ctx.stroke();
      ctx.fillStyle = '#fff'; ctx.font = '12px monospace';
      ctx.fillText('P' + (i + 1) + ' ' + p[3] + 'HP', p[0] - 20, p[1] - 24);
    });
    ctx.fillStyle = '#fff'; ctx.font = 'bold 20px monospace';
    ctx.fillText(lastSnap.score[0] + '  :  ' + lastSnap.score[1], W / 2 - 40, 30);
    ctx.fillText('' + Math.ceil(lastSnap.time), W / 2 - 10, 56);
  }

  // --- server messages ---
  bridge.on('room', (msg) => { roomCode = msg.code; mySeat = msg.youSeat; buildMap(msg.seed); });
  bridge.on('countdown', (m) => { if (m.t === 0) { inputSeq = 0; snapPrev = snapCur = null; startGameView(); } });
  // T9: 100ms interpolation buffer — smooth remote motion between 30Hz snapshots
  let snapPrev = null, snapCur = null;
  bridge.on('snapshot', (m) => {
    snapPrev = snapCur;
    snapCur = { m, t: performance.now() };
  });
  bridge.on('roundEnd', (m) => {
    $('game-status').textContent = m.winner === mySeat ? 'ROUND WON' : m.winner == null ? 'DRAW' : 'ROUND LOST';
  });
  bridge.on('matchEnd', (m) => {
    $('game-status').textContent = m.winner === mySeat ? 'VICTORY ' + m.scores[mySeat] + ':' + m.scores[1 - mySeat] : 'DEFEAT ' + m.scores[mySeat] + ':' + m.scores[1 - mySeat];
    setTimeout(endGameView, 4000);
  });
  bridge.on('peerLeft', () => { $('game-status').textContent = 'OPPONENT LEFT'; });

  async function ensureConnected() {
    $('conn-error').hidden = true;
    const nick = $('nick').value.trim();
    if (nick.length < 2) { showLobbyError('Nickname must be 2-16 characters.'); return false; }
    setNick(nick);
    if (bridge.authed) return true;
    try {
      await bridge.connect(wsUrl + '/ws');
      return true;
    } catch {
      showLobbyError('Cannot reach the game server. Try again shortly.');
      return false;
    }
  }

  function showLobbyError(msg) { const el = $('conn-error'); el.textContent = msg; el.hidden = false; }

  function enterRoom(msg) {
    $('lobby').hidden = true;
    $('room-panel').hidden = false;
    $('room-code').textContent = msg.code;
    const link = new URL(location.href);
    link.search = '?room=' + msg.code;
    $('share-link').textContent = link.href;
    renderSeats(msg);
    $('room-status').textContent = msg.seats.every(s => s)
      ? 'Opponent found. Starting soon…'
      : 'Waiting for an opponent to join…';
  }

  function renderSeats(msg) {
    const ul = $('seats');
    ul.textContent = '';
    msg.seats.forEach((seat, i) => {
      const li = document.createElement('li');
      const label = document.createElement('strong');
      label.textContent = seat ? seat.nick : '— waiting —';
      li.appendChild(label);
      const tag = document.createElement('span');
      tag.className = 'seat-tag';
      tag.textContent = i === msg.youSeat ? ' (you)' : ' (opponent)';
      li.appendChild(tag);
      ul.appendChild(li);
    });
  }

  function backToLobby() {
    $('room-panel').hidden = true;
    $('lobby').hidden = false;
    $('lobby-status').textContent = '';
  }

  bridge.on('room', enterRoom);
  bridge.on('roomError', (m) => {
    if (!$('room-panel').hidden) backToLobby();
    showLobbyError(m.reason || 'Room error.');
    $('lobby-status').textContent = '';
  });
  bridge.on('queued', (m) => { $('lobby-status').textContent = 'Searching… position ' + m.position; });
  bridge.on('peerLeft', () => { $('room-status').textContent = 'Opponent left. Waiting…'; });
  bridge.on('disconnected', () => { backToLobby(); showLobbyError('Disconnected from server.'); });

  $('btn-quick').addEventListener('click', async () => {
    if (!(await ensureConnected())) return;
    $('lobby-status').textContent = 'Searching…';
    bridge.send('quick');
  });
  $('btn-create').addEventListener('click', async () => {
    if (!(await ensureConnected())) return;
    bridge.send('create');
  });
  $('btn-join').addEventListener('click', async () => {
    if (!(await ensureConnected())) return;
    const code = $('join-code').value.trim().toUpperCase();
    if (code.length !== 5) { showLobbyError('Room code is 5 characters.'); return; }
    bridge.send('join', { code });
  });
  $('btn-leave').addEventListener('click', () => { bridge.send('leave'); backToLobby(); });
  $('btn-forfeit').addEventListener('click', () => { bridge.send('forfeit'); });

  // Share-link deep join
  const roomParam = new URLSearchParams(location.search).get('room');
  if (roomParam && /^[A-Z0-9]{5}$/i.test(roomParam)) {
    $('join-code').value = roomParam.toUpperCase();
    $('nick').value = getNick();
    ensureConnected().then(ok => { if (ok) bridge.send('join', { code: roomParam.toUpperCase() }); });
  } else {
    $('nick').value = getNick();
  }
</script>
