---
import '../../styles/global.css';
import GameShell from '../../components/GameShell';
import SEO from '../../components/SEO.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO
      title="NOX // Void Trials - Solo survival, one player, one keyboard"
      description="Void Trials solo mode. 10 minutes. One player vs AI on 2x arena. Void crush at 7:30. Score points, survive or kill the bot."
      canonical="/play/trials"
      structuredData={{
        "@context": "https://schema.org",
        "@type": "VideoGame",
        name: "NOX // Void Trials",
        description: "Solo survival trial. 10 minutes, one player vs AI, 2x arena, void crush, scoring.",
        url: "https://nox-void.vercel.app/play/trials",
        image: "https://nox-void.vercel.app/og.png",
        numberOfPlayers: { "@type": "QuantitativeValue", minValue: 1, maxValue: 1 },
        playMode: "Single"
      }}
    />
  </head>
  <body>
    <div id="game-desc" aria-label="Solo survival arena. Keyboard only: WASD to move, Shift to dash, Space to shoot, P pauses. Score breakdown shows survival, hit bonus, pickup bonus, and penalties." style="position:absolute;left:-10000px;top:auto;width:1px;height:1px;overflow:hidden;"></div>
    <GameShell mode="trials" client:load />
    <script>
      // Prepare menu HUD to show 10:00 immediately (before first start)
      const tryPrepare = () => {
        const g = (window as unknown as { NOX_GAME?: { prepareTrialsMenu?: () => void } }).NOX_GAME;
        if (g?.prepareTrialsMenu) g.prepareTrialsMenu();
        else setTimeout(tryPrepare, 30);
      };
      tryPrepare();
      const onStartTrials = () => {
        const tryStart = () => {
          const g = (window as unknown as { NOX_GAME?: { startTrials?: () => void } }).NOX_GAME;
          if (g?.startTrials) g.startTrials();
          else setTimeout(tryStart, 30);
        };
        tryStart();
      };
      window.addEventListener('nox:startTrials', onStartTrials);
      window.addEventListener('nox:resumeTrial', () => {
        const tryResume = () => {
          const g = (window as unknown as { NOX_GAME?: { resumeTrials?: () => boolean } }).NOX_GAME;
          if (g?.resumeTrials) {
            g.resumeTrials();
            document.getElementById('startOverlay')?.classList.add('hidden');
          } else setTimeout(tryResume, 30);
        };
        tryResume();
      });
      const onForfeitTrials = () => {
        const g = (window as unknown as { NOX_GAME?: { forfeitTrials?: () => void } }).NOX_GAME;
        if (g?.forfeitTrials) g.forfeitTrials();
      };
      window.addEventListener('nox:forfeitTrials', onForfeitTrials);
      window.addEventListener('nox:forfeit', (e) => {
        // Only handle generic forfeit if no dedicated forfeitTrials handler will run;
        // trials page prefers nox:forfeitTrials, but handle fallback for pause overlay calling generic
        const g = (window as unknown as { NOX_GAME?: { getGameMode?: () => string } }).NOX_GAME;
        if (g?.getGameMode?.() === 'trials') {
          onForfeitTrials();
        }
      });
      window.addEventListener('nox:backToMenu', () => {
        const tryMenu = () => {
          const g = (window as unknown as { NOX_GAME?: { backToMenu?: () => void } }).NOX_GAME;
          if (g?.backToMenu) g.backToMenu();
          else setTimeout(tryMenu, 30);
        };
        tryMenu();
      });
    </script>
  </body>
</html>